# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection URL
# Local PostgreSQL format: postgresql://postgres:password@localhost:5432/anime_hub
# Cloud PostgreSQL format (Neon / Supabase / Railway): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anime_hub

# JWT Secret for User Authentication
JWT_SECRET=anime_hub_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
